# Google Calendar Service Account credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com

# Display settings
NEXT_PUBLIC_OWNER_NAME=Marc
NEXT_PUBLIC_OWNER_TIMEZONE=Europe/London

# Meeting link (Google Meet personal room, Zoom, etc.)
# This link is included in the calendar invite and confirmation email.
MEETING_LINK=https://meet.google.com/your-personal-link

# Resend API key for confirmation emails
# Sign up free at https://resend.com → get your API key
RESEND_API_KEY=re_xxxxxxxxxxxxx
# Optional: use a custom from address (requires domain verification in Resend)
# RESEND_FROM=interviews@yourdomain.com
